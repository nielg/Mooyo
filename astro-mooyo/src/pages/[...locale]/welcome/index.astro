---
import { Image } from "astro:assets";

import Layout from "@layouts/Layout.astro";
import zon from "../../../assets/zon-transparant.png";
import {
  getLangFromUrl,
  getStaticPaths,
  useTranslatedPath,
  useTranslations,
} from "../../../i18n/utils";
import AanbodCardContainer from "@components/AanbodCardContainer.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
export { getStaticPaths };
---

<Layout title="Wees welkome">
  <section class="welcome back-gray text-black center">
    <div class="container">
      <Image
        src={zon}
        alt="tekening"
        class="img"
        width={450}
        height={450}
        loading="eager"
      />
      <div>
        <h2 class="text-align-center text-red">{t("index.welcome.title")}</h2>
        <p set:html={t("index.welcome.text")} />
        <p class="content-end">Francis Weller</p>
      </div>
    </div>
  </section>
  <section class="s3 back-red center">
    <div class="col3 text-black text-align-justify">
      <div class="card">
        <p class="text-align-center text-red bold">
          {t("index.s3.col1.title")}
        </p>
        <div class="regular-font">
          <p>{t("index.s3.col1.text1")}</p>
          <p>{t("index.s3.col1.text2")}</p>
          <p>{t("index.s3.col1.text3")}</p>
        </div>
      </div>
      <div class="card">
        <p class="text-red text-align-center bold">
          {t("index.s3.col2.title")}
        </p>
        <div class="regular-font">
          <p>{t("index.s3.col2.text1")}</p>
          <p>{t("index.s3.col2.text2")}</p>
          <p>{t("index.s3.col2.text3")}</p>
        </div>
      </div>
      <div class="card">
        <p class="text-red text-align-center bold">
          {t("index.s3.col3.title")}
        </p>
        <div class="regular-font">
          <p>{t("index.s3.col3.text1")}</p>
          <p>{t("index.s3.col3.text2")}</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-gray text-gray center text-align-center">
    <p class="p2">
      Mooyo is een uitnodiging om volledig aanwezig te zijn met alles wat je
      meedraagt, precies zoals je bent.
    </p>
    <div class="btn-container">
      <a href={translatePath("/filosofie")} class="btn red-btn"
        >Meer weten over de filosofie</a
      >
      <a href={translatePath("/aanbod")} class="btn red-btn"
        >Meer weten over het aanbod</a
      >
    </div>
  </section>
</Layout>

<style>
  section {
    padding: 2rem;
  }
  .welcome .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 70rem;
    column-gap: 4rem;
  }

  .welcome .img {
    max-width: 500px;
    max-height: 500px;
    width: 100%;
    height: auto;
  }

  .col3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4rem;
    margin: auto;
    max-width: 1700px;
  }
  .btn-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 40vw;
    gap: 2rem;
  }

  .card {
    background-color: var(--mooyo-white);
    padding: 2rem;
    border-radius: 10px;
  }

  @media (max-width: 1100px) {
    .col3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 800px) {
    .welcome .container {
      grid-template-columns: 1fr;
    }

    .btn-container {
      flex-direction: column;
    }
  }
</style>
