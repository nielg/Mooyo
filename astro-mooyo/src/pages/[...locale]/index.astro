---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import hart_rond from "../../assets/rondevormen/hart_rond.png";
import profiel from "../../assets/profiel-square.png";
import ContactSection from "@components/Contact-section.astro";
import {
  getStaticPaths,
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
import AanbodCardContainer from "@components/AanbodCardContainer.astro";
import Socials from "@components/Socials.astro";
import HomeBlog from "@components/HomeBlog.astro";
export { getStaticPaths };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title="Home">
  <section class="intro back-gray text-align-center text-gray center">
    <div class="container">
      <div class="center">
        <Image
          src={hart_rond}
          class="img hart"
          alt="Mooyo logo"
          width={450}
          height={450}
          loading="eager"
        />
      </div>
      <div class="text">
        <h1 class="text-red">Mooyo</h1>
        <p>{t("index.intro.text1")}</p>
        <p>∞ ∞ ∞</p>
        <p>{t("index.intro.text2")}</p>
        <p>∞ ∞ ∞</p>
        <p>{t("index.intro.text3")}</p>
      </div>
    </div>
  </section>

  <section class="s4 back-red text-align-center text-white regular-font">
    <div class="text-margin">
      <p>{t("index.s4.text1")}</p>
      <p>{t("index.s4.text2")}</p>
    </div>
  </section>

  <section class="profile back-white text-black regular-font">
    <Image src={profiel} class="img" alt="Profiel foto van Bram Geysen" />
    <div class="text">
      <h2 class="text-red papyrus-font">Bram Geysen</h2>
      <p>
        Rondestraat 38 <br /> 3000 Leuven, Belgium <br />
        {t("index.distance.station")}
      </p>
      <h4 class="title papyrus-font">Contact</h4>
      <p class="text-red">
        <a href="tel:+32473523094">[+32 473 52 30 94]</a>
      </p>
      <p class="text-red">
        <a href="mailto:bramgeysen@gmail.com" class="text-red"
          >[bramgeysen@gmail.com]</a
        >
      </p>
      <h4 class="title papyrus-font">Socials</h4>
      <Socials />
      <p class="about-link">
        <a href={translatePath("/about")}>Lees hier meer over mij</a>
      </p>
    </div>
  </section>
  <AanbodCardContainer />
  <ContactSection color="gray" />
  <HomeBlog />
</Layout>

<style>
  section {
    padding: 2rem;
  }

  .intro .container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  .intro .text {
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .s4 {
    font-size: 2rem;
  }

  .intro .img-container .img {
    width: 100%;
    height: auto;
    max-width: 450px;
    max-height: 450px;
  }

  .profile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0;
  }

  .profile .img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  .profile .text {
    padding: 2rem;
  }

  .profile .title {
    font-weight: 700;
  }

  .profile .about-link {
    border-bottom: 1px solid var(--mooyo-red);
    width: fit-content;
    padding: 0 0 0.3rem 0;
  }

  .profile .socials-container {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 2rem;
  }

  .content-end {
    text-align: end;
  }

  /* Responsive */
  @media (max-width: 1900px) {
    .profile .img {
      top: 0;
    }
  }

  @media (max-width: 1200px) {
    .s3 .col3 {
      display: grid;
      grid-template-columns: auto;
    }
  }

  @media (max-width: 900px) {
    .intro .container,
    .welcome .container,
    .profile {
      grid-template-columns: auto;
    }
    .intro .img {
      display: none;
    }

    .welcome .img,
    .profile .img {
      grid-row: 2;
      min-width: unset;
    }

    .profile {
      padding: 0;
    }

    .profile .img {
      width: 100%;
    }
  }
</style>
