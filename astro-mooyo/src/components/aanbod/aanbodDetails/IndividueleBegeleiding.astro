---
import s from "../../../styles/aanbodCards.module.css";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Card 1: E1 -->
<div class:list={[s.card, s.expanding]}>
  <div class={s.main}>
    <p class="bold text-red papyrus-font">
      {t("Prices.e1.title1")}
    </p>
    <ul class="infinity-list text-black">
      <li><span>{t("Prices.e1.li1")}</span></li>
      <li><span>{t("Prices.e1.li2")}</span></li>
    </ul>
    <p class={s.seeMore}>{t("Prices.seeMore")}</p>
    <div class={s.details}>
      <p>{t("Prices.e1.details")}</p>
    </div>
  </div>
</div>

<!-- Card 2: Adolescenten -->
<div class:list={[s.card, s.expanding]}>
  <div class={s.main}>
    <p class="bold text-red papyrus-font">
      {t("Prices.footprints.title")}
    </p>
    <ul class="infinity-list text-black">
      <li><span>{t("Prices.footprints.li1")}</span></li>
      <li><span>{t("Prices.footprints.li2")}</span></li>
    </ul>
    <p class={s.seeMore}>{t("Prices.seeMore")}</p>
    <div class={s.details}>
      <p>{t("Prices.footprints.details.text1")}</p>
      <ul class="dashed-list">
        <li>{t("Prices.footprints.details.li1")}</li>
        <li>{t("Prices.footprints.details.li2")}</li>
        <li>{t("Prices.footprints.details.li3")}</li>
        <li>{t("Prices.footprints.details.li4")}</li>
        <li>{t("Prices.footprints.details.li5")}</li>
      </ul>
      <p>{t("Prices.footprints.details.text2")}</p>
    </div>
  </div>
</div>

<!-- Card 3: Hartcoherentie -->
<div class:list={[s.card, s.expanding]}>
  <div class={s.main}>
    <p class="bold text-red papyrus-font">
      {t("Prices.burnout.title")}
    </p>
    <ul class="infinity-list text-black">
      <li><span>{t("Prices.e1.li1")}</span></li>
      <li><span>{t("Prices.e1.li2")}</span></li>
    </ul>
    <p class={s.seeMore}>{t("Prices.seeMore")}</p>
    <div class={s.details}>
      <p>{t("Prices.burnout.description")}</p>
      <ul>
        <li>
          <span class="text-red bold">{t("Prices.burnout.stress.title")}</span>
          {t("Prices.burnout.stress.text")}
        </li>
        <li>
          <span class="text-red bold">{t("Prices.burnout.emotions.title")}</span
          >
          {t("Prices.burnout.emotions.text")}
        </li>
        <li>
          <span class="text-red bold"
            >{t("Prices.burnout.connection.title")}</span
          >
          {t("Prices.burnout.connection.text")}
        </li>
      </ul>
    </div>
  </div>
</div>

<!-- Card 4: Koppels -->
<div class:list={[s.card, s.expanding]}>
  <div class={s.main}>
    <p class="bold text-red papyrus-font">
      {t("Prices.koppels.title")}
    </p>
    <ul class="infinity-list text-black">
      <li><span>{t("Prices.koppels.li1")}</span></li>
      <li><span>{t("Prices.koppels.li2")}</span></li>
    </ul>
    <p class={s.seeMore}>{t("Prices.seeMore")}</p>
    <div class={s.details}>
      <p>{t("Prices.koppels.details")}</p>
    </div>
  </div>
</div>

<script src="../../../utils/aanbod.js"></script>
