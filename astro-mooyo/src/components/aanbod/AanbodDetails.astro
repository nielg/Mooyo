---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Tabs } from "./Aanbod2.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Props = {
  activeTab: Tabs;
};

const { activeTab } = Astro.props;
---

<div id="container">
  {
    activeTab === "individuele_begeleiding" && (
      <div class="card expanding back-gray">
        <div class="main">
          <h4 class="bold text-red papyrus-font">{t("Prices.e1.title1")}</h4>
          <ul class="infinity-list text-black">
            <li>
              <span>{t("Prices.e1.li1")}</span>
            </li>
            <li>
              <span>{t("Prices.e1.li2")}</span>
            </li>
          </ul>
          <p class="seeMore">{t("Prices.seeMore")}</p>
          <div class="details">
            <p>{t("Prices.e1.details")}</p>
          </div>
        </div>
      </div>
    )
  }

  {
    activeTab === "organisaties_teams" && (
      <div class="card expanding text-align-justify">
        <div class="main">
          <h4 class="bold text-red text-align-center papyrus-font">
            {t("Prices.reconstructive.title")}
          </h4>
          <p set:html={t("Prices.reconstructive.text")} />
          <p>
            {t("Prices.info")}
            <a href="mailto:bramgeysen@gmail.com">bramgeysen@gmail.com</a>
          </p>
          <p class="seeMore">{t("Prices.seeMore")}</p>
          <div class="details">
            <div class="card-aanbod">
              <ul>
                <li>
                  <span class="bold">{t("Prices.label.format")}:</span>
                  {t("Prices.reconstructive.format")}
                </li>
                <li>
                  <span class="bold">{t("Prices.label.for")}:</span>
                  {t("Prices.reconstructive.for")}
                </li>
                <li>
                  <span class="bold">{t("Prices.label.location")}:</span>
                  {t("Prices.reconstructive.location")}
                </li>
                <li>
                  <span class="bold">{t("Prices.label.max")}:</span>
                  {t("Prices.reconstructive.max")}
                </li>
                <li>
                  <span class="bold">{t("Prices.label.data")}:</span>
                  <ul>
                    <li>{t("Prices.reconstructive.data.li1")}</li>
                    <li>{t("Prices.reconstructive.data.li2")}</li>
                  </ul>
                </li>
                <li>
                  <span class="bold">{t("Prices.label.price")}:</span>
                  {t("Prices.reconstructive.price")}
                </li>
              </ul>
              <p>{t("Prices.reconstructive.lunch")}</p>
            </div>
            <p>{t("Prices.reconstructive.body1")}</p>
            <p>{t("Prices.reconstructive.body2")}</p>
            <p>{t("Prices.reconstructive.body3")}</p>
            <p>{t("Prices.reconstructive.body4")}</p>
            <ul>
              <li>{t("Prices.reconstructive.li1")}</li>
              <li>{t("Prices.reconstructive.li2")}</li>
              <li>{t("Prices.reconstructive.li3")}</li>
              <li>{t("Prices.reconstructive.li4")}</li>
              <li>{t("Prices.reconstructive.li5")}</li>
            </ul>
            <p>
              {t("Prices.moreInfo")}
              <a
                href="https://www.reconstructive.be"
                target="_blank"
                rel="noopener noreferrer"
              >
                www.reconstructive.be
              </a>
            </p>
            <p class="text-gray text-align-start">
              {t("Prices.collab")}
              <a
                href="https://www.cominz.be"
                target="_blank"
                rel="noopener noreferrer"
              >
                www.cominz.be
              </a>
            </p>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  #container {
    background-color: var(--mooyo-white);
    padding: 2rem;
    border: 1px solid var(--mooyo-black);
    border-radius: 0 0 10px 10px;
    z-index: 1;
  }

  h5 {
    font-size: 1.2rem;
  }

  .card {
    background-color: var(--mooyo-gray);
    padding: 2rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin: 2rem;
    color: black;
    box-sizing: border-box;
  }

  .expanding {
    flex: 1 1 0%;
    overflow: hidden;
    min-width: 0;
    transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    min-height: 460px;
  }

  .expanding.is-active {
    flex: 2;
  }

  .main {
    margin-left: 2rem;
  }

  .card-aanbod {
    border-bottom: 1px double gray;
  }

  .details {
    opacity: 0;
    max-height: 0;
    transform: translateY(20px);
    transition:
      opacity 1s ease-out,
      transform 0.4s ease-out;
    visibility: hidden;
  }

  .flex-column .details {
    transition: max-height 0.4s ease-in-out;
  }

  .expanding.is-active .details {
    opacity: 1;
    visibility: visible;
    max-height: 2000px;
    width: 100%;
    transform: translateY(0);
    transition: max-height 0.4s ease-in-out;
  }

  .seeMore {
    margin-top: 1rem;
    margin-bottom: 0;
    font-weight: bold;
    transition: opacity 1s ease;
  }

  .expanding.is-active .seeMore {
    opacity: 0;
    height: 0;
    margin: 0;
    overflow: hidden;
  }

  a {
    border-bottom: 1px solid var(--mooyo-red);
    color: var(--mooyo-red);
  }
</style>

<script>
  function initAanbodCards() {
    const cards = document.querySelectorAll(".expanding");

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        cards.forEach((anyCard) => {
          anyCard.classList.remove("is-active");
        });

        card.classList.add("is-active");
      });
    });
  }

  document.addEventListener("astro:page-load", initAanbodCards);
</script>
