---
import { getLangFromUrl, useTranslations } from "@src/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
import IndividueleBegeleiding from "./aanbodDetails/IndividueleBegeleiding.astro";
import Organisaties from "./aanbodDetails/Organisaties.astro";
import TransformatieveBeleving from "./aanbodDetails/TransformatieveBeleving.astro";

export type Tabs =
  | "individuele_begeleiding"
  | "transformatieve_belevingen"
  | "organisaties_teams";
---

<section class="back-red regular-font">
  <div id="header">
    <h1 class="text-white text-align-center papyrus-font">
      {t("Prices.header")}
    </h1>
  </div>
  <div id="tab-container" role="tablist">
    <button
      class="tab"
      data-tab="individuele_begeleiding"
      id="individuele_begeleiding"
      role="tab"
      aria-selected="false"
      aria-controls="panel-individuele_begeleiding"
    >
      <h4>{t("Prices.title.individual")}</h4>
    </button>
    <button
      class="tab active"
      data-tab="transformatieve_belevingen"
      id="tab-transformatieve_belevingen"
      role="tab"
      aria-selected="true"
      aria-controls="panel-transformatieve_belevingen"
    >
      <h4>{t("Prices.title.transformatief")}</h4>
    </button>
    <button
      class="tab"
      data-tab="organisaties_teams"
      id="tab-organisaties_teams"
      role="tab"
      aria-selected="false"
      aria-controls="panel-organisaties_teams"
    >
      <h4>{t("Prices.title.organizations")}</h4>
    </button>
  </div>
  <div id="details-container">
    <div
      id="panel-individuele_begeleiding"
      class="details"
      role="tabpanel"
      aria-labelledby="individuele_begeleiding"
      hidden
    >
      <IndividueleBegeleiding />
    </div>
    <div
      id="panel-transformatieve_belevingen"
      class="details"
      role="tabpanel"
      aria-labelledby="tab-transformatieve_belevingen"
    >
      <TransformatieveBeleving />
    </div>
    <div
      id="panel-organisaties_teams"
      class="details"
      role="tabpanel"
      aria-labelledby="tab-organisaties_teams"
      hidden
    >
      <Organisaties />
    </div>
  </div>
</section>

<script>
  const init = () => {
    const tabs = document.querySelectorAll<HTMLElement>(".tab");
    const details = document.querySelectorAll<HTMLElement>(".details");

    if (!tabs.length || !details.length) return;

    const setActiveTab = (selectedId: string) => {
      details.forEach((detail) => {
        detail.hidden = detail.id !== `panel-${selectedId}`;
      });

      tabs.forEach((tab) => {
        const isSelected = tab.dataset.tab === selectedId;
        tab.classList.toggle("active", isSelected);
        tab.setAttribute("aria-selected", isSelected ? "true" : "false");
        tab.tabIndex = isSelected ? 0 : -1;
      });
      history.replaceState(null, "", `#${selectedId}`);
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const tabId = tab.dataset.tab;
        if (tabId) setActiveTab(tabId);
      });
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
          return;
        }

        event.preventDefault();
        const currentIndex = Array.from(tabs).indexOf(tab);
        let nextIndex = currentIndex;

        if (event.key === "ArrowRight") {
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (event.key === "ArrowLeft") {
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        }

        const nextTab = tabs[nextIndex];
        const tabId = nextTab.dataset.tab;
        if (tabId) {
          setActiveTab(tabId);
          nextTab.focus();
        }
      });
    });

    const initialHash = window.location.hash.replace("#", "");

    const matchingTab = Array.from(tabs).find(
      (tab) => tab.dataset.tab === initialHash,
    );

    if (matchingTab && initialHash) {
      setActiveTab(initialHash);
    } else {
      const defaultTab =
        Array.from(tabs).find((tab) => tab.classList.contains("active")) ??
        tabs[0];
      const defaultTabId = defaultTab?.dataset.tab;
      if (defaultTabId) setActiveTab(defaultTabId);
    }
  };

  document.addEventListener("astro:page-load", init);
</script>

<style>
  section {
    width: 100%;
  }

  #header {
    padding: 3rem;
  }
  #tab-container {
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    position: relative;
    z-index: 2;
  }

  .tab {
    position: relative;
    background-color: transparent;
    border: 1px solid var(--mooyo-black);
    padding: 0.2rem 2rem;
    border-radius: 10px 10px 0 0;
    font: inherit;
    border-bottom: none;
    margin-bottom: -1px;
    cursor: pointer;
    background-color: var(--mooyo-white);
    opacity: 0.5;

    filter: drop-shadow(0px -1px 0px var(--mooyo-black))
      drop-shadow(-1px 0px 0px var(--mooyo-black))
      drop-shadow(1px 0px 0px var(--mooyo-black));
    border-radius: 10px 10px 0 0;
  }

  .tab.active {
    border: none;
    opacity: 1;
  }

  .tab::before,
  .tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
    background-color: var(--mooyo-white);
  }

  .tab::before {
    left: -10px;
    -webkit-mask: radial-gradient(
      circle at 0 0,
      transparent 10px,
      black 10.5px
    );
    mask: radial-gradient(circle at 0 0, transparent 10px, black 10.5px);
  }

  .tab::after {
    right: -10px;
    -webkit-mask: radial-gradient(
      circle at 100% 0,
      transparent 10px,
      black 10.5px
    );
    mask: radial-gradient(circle at 100% 0, transparent 10px, black 10.5px);
  }

  #details-container {
    background-color: var(--mooyo-white);
    border-top: 1px solid var(--mooyo-black);
    z-index: 1;
    padding-bottom: 2rem;
  }

  @media (max-width: 1000px) {
    #tab-container {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
    .tab {
      text-align: center;
      width: 100%;
    }
  }
</style>
