---
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@src/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const posts_query = `*[
  _type == "post" 
  && defined(slug.current)
  && language == $lang
] | order(publishedAt desc)[0...2] {
  _id, 
  title, 
  slug, 
  description,
  language
}`;

const posts = await sanityClient.fetch<SanityDocument[]>(posts_query, { lang });
---

<section class="back-red text-white blog">
  <div class="small-text-margin center">
    <h2 class="text-align-center">{t("index.blog.title")}</h2>
    <hr class="white-line" />
    {
      posts && posts.length === 0 && (
        <div class="no-posts-container">
          <p>{t("index.blog.noPosts")}</p>
        </div>
      )
    }
    {
      posts && posts.length > 0 && (
        <div class="col2">
          {posts.map((post) => (
            <a
              href={translatePath(`/posts/${post.slug.current}`)}
              class="center post-card-link"
            >
              <div class="post-card-wrapper">
                <div>
                  <h4 class="text-align-center">{post.title}</h4>
                  <p class="text-align-center">{post.description}</p>
                </div>
                <span class="white-btn btn center">{t("post.readMore")}</span>
              </div>
            </a>
          ))}
        </div>
      )
    }
    <hr class="white-line" />
  </div>
</section>

<style>
  .col2 {
    margin: 1rem 0;
  }
</style>
